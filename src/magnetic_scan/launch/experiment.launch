<launch>
  <arg name="config"/>
  <arg name="source_arm" default="arm1"/>
  <arg name="start_vision" default="false"/>
  <arg name="start_sensors" default="false"/>
  <node pkg="magnetic_scan" type="scan_bringup" name="magnetic_scan_bringup" output="screen" required="true"
        args="--config &quot;$(arg config)&quot; --source-arm $(arg source_arm) $(eval '--vision' if arg('start_vision') == 'true' else '') $(eval '--sensors' if arg('start_sensors') == 'true' else '')"/>
</launch>
