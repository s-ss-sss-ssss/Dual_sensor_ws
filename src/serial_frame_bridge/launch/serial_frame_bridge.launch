<launch>
  <arg name="port" default="/dev/maggrad" />
  <arg name="baud_rate" default="115200" />
  <node pkg="serial_frame_bridge" type="serial_frame_bridge_node" name="serial_frame_bridge" output="screen">
    <param name="port" value="$(arg port)" />
    <param name="baud_rate" value="$(arg baud_rate)" />
  </node>
</launch>
