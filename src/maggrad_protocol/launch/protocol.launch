<launch>
  <arg name="raw_frame_topic" default="/serial_frame_bridge/raw_frames"/>
  <arg name="sample_topic" default="/maggrad/sample"/>
  <node pkg="maggrad_protocol" type="protocol_node" name="maggrad_protocol" output="screen">
    <rosparam command="load" file="$(find maggrad_protocol)/config/expected_sensors.yaml"/>
    <param name="raw_frame_topic" value="$(arg raw_frame_topic)"/>
    <param name="sample_topic" value="$(arg sample_topic)"/>
  </node>
</launch>
